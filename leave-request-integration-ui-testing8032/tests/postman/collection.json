  "item": [
    {
      "name": "1 - Create Leave Request",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// requestId پویا در environment ذخیره می‌شود",
              "pm.environment.set(\"requestId\", \"\")",
              "pm.environment.set(\"createdRequestId\", \"\")"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const ts = Date.now();",
              "const emp = \"emp-\" + ts;",
              "pm.environment.set(\"employeeId\", emp);",
              "pm.environment.set(\"fromDate\", \"2026-03-01\");",
              "pm.environment.set(\"toDate\", \"2026-03-03\");",
              "pm.environment.set(\"reason\", \"Integration test \" + ts);",
              "",
              "pm.test(\"Status is 201\", function(){ pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test(\"requestId exists\", function(){ pm.expect(body).to.have.property(\"requestId\"); });",
              "pm.test(\"state is PENDING\", function(){ pm.expect(body.state).to.eql(\"PENDING\"); });",
              "pm.environment.set(\"requestId\", body.requestId);",
              "pm.environment.set(\"createdRequestId\", body.requestId);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeId\": \"{{employeeId}}\",\n  \"fromDate\": \"{{fromDate}}\",\n  \"toDate\": \"{{toDate}}\",\n  \"reason\": \"{{reason}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/leave/request",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "leave",
            "request"
          ]
        }
      }
    },
    {
      "name": "2 - Get Detail",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", function(){ pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test(\"state is PENDING\", function(){ pm.expect(body.state).to.eql(\"PENDING\"); });",
              "pm.test(\"employeeId matches created data\", function(){ pm.expect(String(body.employeeId)).to.eql(pm.environment.get(\"employeeId\")); });",
              "pm.test(\"id matches dynamic requestId\", function(){ pm.expect(pm.environment.get(\"requestId\")).to.not.be.null; });"
            ],
            "type": "text/javascript"
          }
        }
      ],
